{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    //Development server tasks
    {
      "label": "Run NextJS Server",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/next"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Postgres Server",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Messaging Server",
      "type": "shell",
      "command": "docker compose up -d messagequeue",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Worker",
      "type": "shell",
      "command": "..\\venv\\scripts\\python",
      "args": [
        "main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Worker"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run NGINX",
      "type": "shell",
      "command": "nginx",
      "args": [
        "-c",
        "conf\\nginx.config"
      ],
      "options": {
        "cwd": "${workspaceFolder}/nginx"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Media Server",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}/MediaServer"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },



    //Docker build tasks
    {
      "label": "Build NextJS Docker Image",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        ".",
        "-t",
        "gallery--next-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}/next"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build Worker Docker Image",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        ".",
        "-t",
        "gallery--worker"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Worker"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
  ]
}