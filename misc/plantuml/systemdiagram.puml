@startuml

top to bottom direction

skinparam nodesep 100
skinparam linewidth 5
/'
skinparam linetype ortho
skinparam ranksep 100
skinparam maxmessagesize 180
'/

package DataSchema{


    json Image_Index_Structure {
    "UUID": "0SB85BA6AWFKK",
    "Date of Creation": 1425412641255,
    "Format": "image/jpg",
    "Status": "Pending",
    "Full Ver. File Path": "./Public/Uploads/Originals/0SB85BA6AWFKK.jpg",
    "Thumbnail File Path": "./Public/Uploads/Thumbnails/0SB85BA6AWFKK.jpg",
    "metadata": "{Exif data object as string}"
    }   
    
    json Image_Hash_Structure {
    "Hash": 1590896250684821214,
    "UUID": "0SB85BA6AWFKK",
    "Hash Version": 1,
    "Embed versions": 1,
    "Embedding": "[0.3232, 0.484, 033333 .... ] "
    }
    
    json Past_Text_Query {
    "Text": "White flower on field",
    "Embedding": "[0.3232, 0.484, 033333 .... ] ",
    "Embed versions": 1,
    "Access Freq": 1,
    "First Searched": 122200000,
    "Last Access": 1222211100
    }
    
    json "System Metric Structure" as System_Metric_Structure {
    "Embeddings Generated": 3554,
    "Median Embedding Latency (Milliseconds)": 5040,
    "Current Queue Depth" : 201,
    "Collection Size (Bytes)": 15005545121
    }
    
    json "Vector Image Index" as VImgIndex{
    "UUID":"0SB85BA6AWFKK",
    "Vector":"[0.5652, 0,256565, ...]",
    "Embedding Version": 1
    }
    
    json "Image Collections Association" as imgcol{
    "Collection ID":"1SB85BA6AWFCC",
    "UUID":"0SB85BA6AWFKK",
    "Added on":122220000
    }
    
    json "Image Collections" as imgcoldata{
    "Collection ID":"1SB85BA6AWFCC",
    "Collection Name": "Beach Pataya 2025",
    "Date Created": 12220000,
    "Last Updated": 12230000,
    "Item numbers":23
    }
    
    json "Face Embeddings" as faceembedsseen{
    "EntryID":12335348795498,
    "Vector":"[...]",
    "Image UUID": "0SB85BA6AWFKK"
    }
    
    json "Face Entry" as faceentry{
    "Face UUID": "2SB85BA6AWFFF",
    "First Embed": "[...]" ,
    "Name": "Unnamed"
    }
}

package databases{

    database "Postgresql" {
    '"Image Index \nSqlite"{
        [Image Index] ..> Image_Index_Structure
    
    
    '"Dedupe and Cache DB \nSqlite"
        [Image Hash] ..> Image_Hash_Structure
        [Text Hash] ..> Past_Text_Query
    
    
    '"Image Collection \nSqlite"
        [Image Collection Names] ..> imgcoldata
        [Image In Collection]  ..> imgcol
    
    'System Metrics
        [System Metric] ..> [System_Metric_Structure]
    
    }
    database "Vector DB \nQDrant"{
        [Vector Image Index] ..> VImgIndex
        [Face Instance Embedding] ..> faceembedsseen
        [Identity Entry] ..> faceentry
    }

}

database "Disk"{
    [originals]
    [thumbnails]
    [defaults]
}

package backends{

    component RabbitMQ {
        [Exchange] --> [Embed queue]
    
    }
    
    component "Workers" as EmbedWorker{
        [Embed queue] --> [Read files]

        'Gen thumbnail and save [IMPLEMENTED]
        [Read files] --> [Generate thumbnail]
        [Generate thumbnail] --> [thumbnails]
        [Generate thumbnail] --> [Image Index] : Update thumbnail path

        'Semantic Search worker [IMPLEMENTED]
        [Read files] --> [Embed image]
        [Embed image] --> [Image Index] : Update status
        [Embed image] --> [Vector Image Index]

        'Face search worker [PLANNED]
        [Read files] --> [Face Detection]
        [Face Detection] --> [Get all face embeddings]
        [Get all face embeddings] --> [Face Instance Embedding] : Writes new face embeddings found

        [Get all face embeddings] --> [For each face]
        [For each face] --> [Identity Entry] : Look up closest match to the face
        [For each face] --> [Upsert new face] : If a look up can't \nfind a close enough match, \nupsert new
        [Upsert new face] --> [Identity Entry]


    }
    
    component EmbedAPI{
        port text as textembedapi
        textembedapi <-> [Embed text]
        ' image embed endpoint [PLANNED]
        port image as imageembedapi
    }
    
    component "Redis Pub Sub" {
        [System Metric (Realtime)]
    }

    component "Go Media Server" as GMS{

    [/admin/status/ws] as statusws
    statusws <-> [System Metric (Realtime)] : Handles real time \nupdate to state
    statusws <-> [System Metric] : Handles persistent \nupdate to disk


    package mediaactionspipeline{
        
        json Methods_API_media_action{
        "POST"  : "Uploads a list of medias",
        "GET"   : "Get list of medias available to the user"
        }
        
        [/media] as mediaendpoint
        mediaendpoint ..> Methods_API_media_action
        package MediaUploadPipeline{
            [media upload] as imguploadendp
            mediaendpoint --> imguploadendp : POST
            imguploadendp <-> [Image Hash Check] : Check for exact repeat
            [Image Hash Check] --> [Image Hash]

            imguploadendp --> [?allowdupe=true] : No repeat filters

            [Image Hash Check] --> [Generate UUID] : Non repeated image
            [?allowdupe=true] --> [Generate UUID] : All images

            [Save image to disk] as Saveimgdisk

            [Generate UUID] --> Saveimgdisk
            Saveimgdisk --> [originals]
            Saveimgdisk --> [Image Index]
            Saveimgdisk --> [Image Hash]
            Saveimgdisk --> [Exchange]
            Saveimgdisk --> [System Metric (Realtime)]
        }

        package SimpleQueryPipeline{
            json "Query Parsing" as simplequeryparsing{
                "want"      : "Hyphen separated values for fields wanted in response \\neg 'uuid-filepath-thumbnail_filepath'",
                "offset"    : "Offset of the response list",
                "limit"     : "Limit of response list",
                "order-by"  : "Hyphen separated values of attribute to order and by what \\neg 'asc-uploaded_at'"
            }

            mediaendpoint --> simplequeryparsing : GET
            simplequeryparsing --> [Check Cache]
            [Check Cache] --> [DB Query]
            [DB Query] --> [Image Index]
            [Check Cache] --> [Custom caching]



            json CacheStruct {
                "Limited size"  : "As to not eat up all the memory",
                "Hash of query" :   "Hash of the query parameters except offset and limits",
                "Map of lists of maps"  :   "Map offers fast random lookup, \\nmaps into a list which offers efficient sequential data lookup, \\nof a map which can be parsed into json easily"
            }

            [Custom caching] --> CacheStruct

        }
        
        package AdvancedQueryPipeline{
            ' [IMPLEMENTED] text query + point_query pagination
            [/media/query] as queryEndpoint

            queryEndpoint --> [Use point_query directly] : If point_query in body \n(pagination, no re-embed)
            queryEndpoint --> [Get new text embed] : If text_query in body
            [Get new text embed] <-> textembedapi
            [Use point_query directly] --> [Query Qdrant recommend]
            [Get new text embed] --> [Query Qdrant recommend]
            [Query Qdrant recommend] --> [Vector Image Index]

            ' Returns embedding in response so client can paginate without re-embedding
            [Query Qdrant recommend] --> [Return results + embedding]

            ' [PLANNED] text query caching
            (Check Text Hash) --> [Text Hash] : Fetch past queries
            (Check Text Hash) --> [Get new text embed] : Novel Query

        }
    
    }

    package colquerypipeline{
        
        json "Methods_API_Collection" {
        "GET" : "Get all available collections",
        "POST": "Create a new collection"
        }

        json "Methods_API_Specific_Collection" {
        "GET" : "Get info about that collection",
        "PATCH" : "Edit info about that collection",
        "DELETE" : "Delete the collection"
        }

        json "Methods_API_Specific_Collection_Images" {
        "GET" : "Get all images in the collection",
        "POST": "Insert (a) new image(s)",
        "DELETE" : "Delete an image from the collection"
        }

        [/collection/:id] as specificCollection
        [/collection/:id/images] as specColImages
        specificCollection --> [System Metric (Realtime)]

        specColImages ..> Methods_API_Specific_Collection_Images


        [Generate generate thumbnail if given] as collectionthumbnailgen
        [/collection] --> collectionthumbnailgen : If given a thumbnail file \n to generate from, generate a thumbnail file?
        collectionthumbnailgen --> [Copy the thumbnail file and save as a thumbnail] : If given uuid to generate thumbnail from?
        [Copy the thumbnail file and save as a thumbnail] <-- [Image Index] : Get thumbnail file path
        [Copy the thumbnail file and save as a thumbnail] --> [Use default if nothing was given]
        [Use default if nothing was given] --> [Image Collection Names]
        
        [/collection] ..> Methods_API_Collection
        [/collection] --> specificCollection
        [/collection] --> specColImages

        specificCollection ..> Methods_API_Specific_Collection

        
    }
}
}


component Next{
    [Gallery Page /] as gallerypage
    [Search Page /search] as searchpage
    [Collections Page /collection] as collectionpage

    ' [IMPLEMENTED]
    gallerypage <--> mediaendpoint : GET paginated list \nPOST upload
    searchpage --> queryEndpoint : POST text_query or point_query
    collectionpage <-> [/collection]

    ' [PLANNED]
    [Frontend] <-> statusws : Realtime metrics
}

component NGINX{
    [nginx] --> [GMS] : /gms/* → Go media server (prefix stripped)
    [nginx] --> [Frontend] : /* → Next frontend (default)
    [nginx] --> [Disk] : /media/* → served directly from /data volume
}

(user) --> [nginx]

@enduml