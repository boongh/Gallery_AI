import boto3
from io import BytesIO


def get_image_from_s3(bucket_name: str, object_key: str) -> Image.Image:
    """Fetch an image from S3 and return it as a Pillow Image object."""
    s3_client = boto3.client("s3", endpoint_url=os.getenv('S3_ENDPOINT'), aws_access_key_id=os.getenv('S3_ACCESS_KEY'), aws_secret_access_key=os.getenv('S3_SECRET_KEY'))
    
    response = s3_client.get_object(Bucket=bucket_name, Key=object_key)
    image_data = response["Body"].read()
    
    return Image.open(BytesIO(image_data))
